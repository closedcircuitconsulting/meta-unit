 arch/arm64/boot/dts/rockchip/rk356x-base-enable-pwm14.dtsi | 5 +++++
 3 files changed, 12 insertions(+)
 create mode 100644 arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3e-unit.dts
 create mode 100644 arch/arm64/boot/dts/rockchip/rk356x-base-enable-pwm14.dtsi

diff --git a/arch/arm64/boot/dts/rockchip/Makefile b/arch/arm64/boot/dts/rockchip/Makefile
index 761d82b4f4f2..3cb6b4abf59c 100644
--- a/arch/arm64/boot/dts/rockchip/Makefile
+++ b/arch/arm64/boot/dts/rockchip/Makefile
@@ -123,6 +123,7 @@ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-quartz64-a.dtb
