diff --git a/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3e-unit.dts b/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3e-unit.dts
new file mode 100644
index 000000000000..947a4a2a81e2
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3e-unit.dts
@@ -0,0 +1,6 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+/dts-v1/;
+
+#include "rk3566-radxa-zero-3e.dts"
+#include "rk356x-base-enable-pwm14.dtsi"
diff --git a/arch/arm64/boot/dts/rockchip/rk356x-base-enable-pwm14.dtsi b/arch/arm64/boot/dts/rockchip/rk356x-base-enable-pwm14.dtsi
new file mode 100644
index 000000000000..0518443794e1
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk356x-base-enable-pwm14.dtsi
@@ -0,0 +1,5 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+&pwm14 {
+    status = "okay";
+};
