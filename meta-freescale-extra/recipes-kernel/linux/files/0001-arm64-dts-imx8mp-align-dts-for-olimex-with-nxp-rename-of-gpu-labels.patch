From f47afe84dde941d60dd60b623e9606e48bfd87cc Mon Sep 17 00:00:00 2001
From: Stephan Kulow <stephan.kulow@siemens.com>
Date: Sat, 25 Jul 2026 12:50:33 +0200
Subject: [PATCH] arm64: dts: imx8mp: align dts for Olimex with NXP's rename of
 gpu labels

Upstream-Status: Pending

---
 arch/arm64/boot/dts/freescale/imx8mp-olimex.dts | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-olimex.dts b/arch/arm64/boot/dts/freescale/imx8mp-olimex.dts
index af5af5495dd1..696e0411e9d6 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-olimex.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-olimex.dts
@@ -7,6 +7,8 @@
 #include <dt-bindings/phy/phy-imx8-pcie.h>
 #include <dt-bindings/usb/pd.h>
 #include "imx8mp.dtsi"
+#include "imx8mp-nxp-display.dtsi"
+#include "imx8mp-nxp-capture.dtsi"
 
 / {
 	model = "Olimex i.MX8MPlus";
@@ -1036,15 +1038,15 @@ &vpu_v4l2 {
 	status = "okay";
 };
 
-&gpu_3d {
+&gpu3d {
 	status = "okay";
 };
 
-&gpu_2d {
+&gpu2d {
 	status = "okay";
 };
 
-&ml_vipsi {
+&npu {
 	status = "okay";
 };
 
